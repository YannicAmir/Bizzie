rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Public Data ---
    match /daily_brands/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // --- User Private Data ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /watchlist/{ticker} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /activities/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // --- Bizzie Chat ---
      match /conversations/{conversationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Written by backend via Admin SDK only

        match /messages/{messageId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if false; // Written by backend via Admin SDK only
        }
      }
    }

    // --- Feedback ---
    match /feedback/{document=**} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // --- Bizzie Chat Ratings ---
    match /bizzie_chat_ratings/{messageId} {
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.user_id == request.auth.uid;
      allow read, delete: if false;
    }

    // --- Cached Company Data (Client-Side Cache) ---
    match /companies/{ticker}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // --- Shared Financial Data (Authenticated Read-Only) ---
    match /upcoming_earnings/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /financial_reports/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /sec_filings/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- Watchlist Stock News (Authenticated Read-Only, written by backend) ---
    match /stock_news/{newsId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- Watchlist Stock Prices (Authenticated Read-Only, written by stock_price_sync) ---
    match /stock_prices/{ticker} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- Weekly Recap Reports ---
    match /weekly_recap/{ticker}/weeks/{weekEndDate} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
